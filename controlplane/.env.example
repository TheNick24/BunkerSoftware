# Control plane configuration. Copy to `.env` and edit.

# --- Operator (human / AI / MCP) authentication ---------------------------
# Long random string. Sent as the `x-operator-token` header.
OPERATOR_TOKEN=change-me-to-a-long-random-string

# --- Device-facing base URL ------------------------------------------------
# This is what the resident agents use to reach this server. It can be a
# direct LAN address, a reverse proxy, or a tunnel you run yourself.
AGENT_BASE_URL=http://127.0.0.1:8080

# --- Listen addresses --------------------------------------------------------
# Operator API + dashboard: loopback only by default. Devices, releases and
# bootstrap are served on the same port; to expose the device ingress on the
# LAN while keeping the operations UI private, keep BIND_HOST loopback and
# reverse-proxy only the paths listed in the README.
BIND_HOST=127.0.0.1
PORT=8080

# --- Pairing ---------------------------------------------------------------
# How long a pairing token stays valid (seconds).
PAIRING_TTL_SECONDS=600

# --- Command limits --------------------------------------------------------
# A command older than this (seconds) is dropped unexecuted.
COMMAND_TTL_SECONDS=3600
# Commands allowed to enqueue (operator side must mirror this allowlist).
COMMAND_ALLOWLIST=inspect,log.read,config.read,config.write,eval_lua,reboot,agent.update,release.deploy,release.rollback,monitor.capture

# --- Data directory ----------------------------------------------------------
DATA_DIR=./data